# ============================================================
# 자동 읽음 처리 규칙 (Auto-Read Rules)
#
# 규칙 구조 (2가지 필드만):
#   - sender: 발신자에 포함된 문자열 (예: "@github.com")
#   - keywords: 제목에 포함된 키워드 (선택, OR 매칭)
#
# sender만 있으면 → 발신자 매칭만
# keywords만 있으면 → 제목 키워드 매칭만
# 둘 다 있으면 → 발신자 AND 키워드 모두 충족
#
# enabled: false → 비활성화
# source: auto(LLM 생성) / manual(직접 추가)
# hits: 매칭 횟수 (자동 추적)
# ============================================================

rules:
  - sender: "@github.com"
    enabled: true
    source: manual
    hits: 0

  - sender: "@atlassian.net"
    enabled: true
    source: manual
    hits: 0

  - keywords: ["프로모션", "뉴스레터", "구독", "unsubscribe"]
    enabled: true
    source: manual
    hits: 0

# 직접 추가 예시:
#  - sender: "noreply@company.com"
#    keywords: ["build", "deploy"]
#    enabled: true
#    source: manual
#    hits: 0
